{
  "hooks": {
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs", "denied", "${CLAUDE_PLUGIN_DATA}"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs", "session-start", "${CLAUDE_PLUGIN_DATA}"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
